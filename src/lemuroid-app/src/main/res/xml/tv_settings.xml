<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/settings"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        android:key="pref_category_roms"
        android:title="@string/settings_category_storage_locations"
        app:iconSpaceReserved="false">

        <Preference
            android:key="@string/pref_key_choose_directory"
            android:title="@string/settings_title_choose_directory"
            android:summary="@string/settings_description_choose_directory"
            app:iconSpaceReserved="false"/>

        <Preference
            android:key="pref_key_tv_save_location"
            android:title="@string/settings_title_save_location"
            android:summary="@string/settings_desc_save_location"
            app:iconSpaceReserved="false"/>

        <Preference
            android:key="pref_key_tv_download_location"
            android:title="@string/settings_title_download_location"
            android:summary="@string/settings_desc_download_location"
            app:iconSpaceReserved="false"/>

    </PreferenceCategory>

    <PreferenceCategory
        android:key="pref_category_tv_smb_logins"
        android:title="@string/settings_category_smb_logins"
        app:iconSpaceReserved="false" />

    <PreferenceCategory
        android:title="@string/settings_category_general"
        app:iconSpaceReserved="false">

        <SwitchPreference
            android:key="@string/pref_key_autosave"
            android:title="@string/settings_title_enable_autosave"
            android:summary="@string/settings_description_enable_autosave"
            app:iconSpaceReserved="false"
            android:defaultValue="true"/>

        <SwitchPreference
            android:key="@string/pref_key_enable_immersive_mode"
            android:title="@string/settings_title_immersive_mode"
            android:summary="@string/settings_description_immersive_mode"
            app:iconSpaceReserved="false"
            android:defaultValue="false"/>

        <SwitchPreference
            android:key="@string/pref_key_hd_mode"
            android:title="@string/settings_title_hd_mode"
            android:summary="@string/settings_description_hd_mode"
            app:iconSpaceReserved="false"
            app:disableDependentsState="true"
            android:defaultValue="false"/>

        <SeekBarPreference
            android:key="@string/pref_key_hd_mode_quality"
            android:title="@string/settings_title_hd_quality"
            android:summary="@string/settings_description_hd_quality"
            app:min="0"
            android:max="2"
            app:seekBarIncrement="1"
            app:showSeekBarValue="false"
            app:iconSpaceReserved="false"
            android:defaultValue="2"/>

        <ListPreference
            android:key="@string/pref_key_shader_filter"
            android:title="@string/display_filter"
            app:iconSpaceReserved="false"
            app:useSimpleSummaryProvider="true"
            android:entries="@array/pref_key_shader_filter_display_names"
            app:entryValues="@array/pref_key_shader_filter_values"
            app:dependency="@string/pref_key_hd_mode"
            android:defaultValue="auto"/>

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/settings_category_system_interaction"
        app:iconSpaceReserved="false">

        <PreferenceScreen
            android:key="@string/pref_key_open_gamepad_settings"
            android:summary="@string/settings_description_gamepad_settings"
            app:iconSpaceReserved="false"
            android:title="@string/settings_title_gamepad_settings"/>

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/settings_category_metadata"
        app:iconSpaceReserved="false">

        <Preference
            android:key="@string/pref_key_edit_thegamesdb_apikey"
            android:title="@string/settings_title_thegamesdb_apikey"
            android:summary="@string/settings_thegamesdb_not_configured"
            app:iconSpaceReserved="false"/>

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/settings_category_consoles"
        app:iconSpaceReserved="false">

        <PreferenceScreen
            android:key="@string/pref_key_open_save_sync_settings"
            android:title="@string/settings_title_save_sync"
            app:summary="@string/settings_description_save_sync"
            app:iconSpaceReserved="false"/>

        <PreferenceScreen
            android:key="@string/pref_key_open_cores_selection"
            android:title="@string/settings_title_open_cores_selection"
            app:summary="@string/settings_description_open_cores_selection"
            app:iconSpaceReserved="false"/>

        <PreferenceScreen
            android:key="@string/pref_key_display_bios_info"
            android:title="@string/settings_title_display_bios_info"
            app:summary="@string/settings_description_display_bios_info"
            app:iconSpaceReserved="false"/>

        <PreferenceScreen
            android:key="@string/pref_key_advanced_settings"
            android:title="@string/settings_title_advanced_settings"
            android:summary="@string/settings_description_advanced_settings"
            app:iconSpaceReserved="false">

            <PreferenceCategory
                android:title="@string/settings_category_general"
                app:iconSpaceReserved="false">

                <SwitchPreference
                    android:key="@string/pref_key_low_latency_audio"
                    android:title="@string/settings_title_low_latency_audio"
                    android:summary="@string/settings_description_low_latency_audio"
                    app:iconSpaceReserved="false"
                    android:defaultValue="false"/>

                <SwitchPreference
                    android:key="@string/pref_key_allow_direct_game_load"
                    android:title="@string/settings_title_direct_game_load"
                    android:summary="@string/settings_description_direct_game_load"
                    app:iconSpaceReserved="false"
                    android:defaultValue="true"/>

            </PreferenceCategory>

            <PreferenceCategory
                android:title="@string/settings_category_system_interaction"
                app:iconSpaceReserved="false">

                <SwitchPreference
                    android:key="@string/pref_key_enable_rumble"
                    android:title="@string/settings_title_enable_rumble"
                    android:summary="@string/settings_description_enable_rumble"
                    app:iconSpaceReserved="false"
                    android:defaultValue="false"/>

            </PreferenceCategory>

            <PreferenceCategory
                android:title="@string/settings_cleanup_section_title"
                app:iconSpaceReserved="false">

                <ListPreference
                    android:key="@string/pref_key_max_cache_size"
                    android:title="@string/settings_title_maximum_cache_usage"
                    app:iconSpaceReserved="false"/>

                <Preference
                    android:key="@string/pref_key_clear_rom_cache_local"
                    android:title="@string/settings_cleanup_rom_cache_local"
                    app:iconSpaceReserved="false"/>

                <Preference
                    android:key="@string/pref_key_clear_rom_cache_saf"
                    android:title="@string/settings_cleanup_rom_cache_saf"
                    app:iconSpaceReserved="false"/>

                <Preference
                    android:key="@string/pref_key_clear_rom_cache_smb"
                    android:title="@string/settings_cleanup_rom_cache_smb"
                    app:iconSpaceReserved="false"/>

                <Preference
                    android:key="@string/pref_key_clear_cover_images_cache"
                    android:title="@string/settings_cleanup_cover_images"
                    app:iconSpaceReserved="false"/>

                <Preference
                    android:key="@string/pref_key_clear_save_files"
                    android:title="@string/settings_cleanup_save_files"
                    app:iconSpaceReserved="false"/>

                <Preference
                    android:key="@string/pref_key_clear_save_states"
                    android:title="@string/settings_cleanup_save_states"
                    app:iconSpaceReserved="false"/>

                <Preference
                    android:key="@string/pref_key_clear_state_previews"
                    android:title="@string/settings_cleanup_state_previews"
                    app:iconSpaceReserved="false"/>

            </PreferenceCategory>

            <PreferenceCategory
                android:title="@string/settings_savegames_backup_section"
                app:iconSpaceReserved="false">

                <Preference
                    android:key="@string/pref_key_export_save_games"
                    android:title="@string/settings_savegames_export_zip"
                    android:summary="@string/settings_savegames_export_zip_description"
                    app:iconSpaceReserved="false"/>

                <Preference
                    android:key="@string/pref_key_import_save_games"
                    android:title="@string/settings_savegames_import_zip"
                    android:summary="@string/settings_savegames_import_zip_description"
                    app:iconSpaceReserved="false"/>

            </PreferenceCategory>

            <PreferenceCategory
                android:title="@string/settings_category_factory_reset"
                app:iconSpaceReserved="false">

                <Preference
                    android:key="@string/pref_key_reset_settings"
                    android:title="@string/settings_title_reset_settings"
                    app:summary="@string/settings_description_reset_settings"
                    app:iconSpaceReserved="false"/>

            </PreferenceCategory>

        </PreferenceScreen>

        <Preference
            android:key="@string/pref_key_open_manual"
            android:title="@string/settings_title_manual"
            android:summary="@string/settings_description_manual"
            app:iconSpaceReserved="false"/>

        <Preference
            android:key="@string/pref_key_open_about"
            android:title="@string/settings_title_about"
            android:summary="@string/settings_description_about"
            app:iconSpaceReserved="false"/>

    </PreferenceCategory>

</PreferenceScreen>
